APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

FIREBASE_CREDENTIALS=storage/app/firebase/firebase-credentials.json

# RevenueCat (in-app subscriptions for iOS / Android)
# Public SDK keys are configured in the Flutter app; these are server-side only.
REVENUECAT_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_APP_ID=
REVENUECAT_APP_ID_IOS=
REVENUECAT_APP_ID_ANDROID=
REVENUECAT_API_BASE_URL=https://api.revenuecat.com
# Webhook secret set in the RevenueCat dashboard (used to verify X-RevenueCat-Webhook-Signature).
REVENUECAT_WEBHOOK_SECRET=
# How the app identifies a RevenueCat customer: 'user_id' (DB id) or 'email'.
REVENUECAT_APP_USER_ID_STRATEGY=user_id

